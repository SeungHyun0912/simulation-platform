# 설계 자리표시자입니다. 실제 값은 .env.local(Git 제외)에 둡니다.

# ── 브라우저(번들)에 들어가는 값: 비밀·사용자 식별자를 넣지 않습니다 ──
VITE_API_BASE_URL=/api/v1
# static: 화면 확인용 정적 예시 데이터(서버 호출 없음, 화면에 "예시" 표시)
# api:    실제 API 호출. 실패해도 static으로 자동 전환하지 않습니다.
VITE_DATA_SOURCE=static
VITE_ENABLE_MOCKS=false

# ── 개발 서버(Vite proxy)만 읽는 값: VITE_ 접두사가 없어 번들에 포함되지 않습니다 ──
# 셸 환경변수로 지정하세요(예: PowerShell  $env:DEV_DEBUG_USER="<app_user.id>"; pnpm dev)
# 값(개발 전용 식별자)은 docs/communication/request-from-backend.md "현재 Backend 상태"를 참고합니다.
# DEV_DEBUG_USER=
# DEV_API_TARGET=http://127.0.0.1:8000
